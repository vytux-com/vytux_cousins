<?php View::push('javascript') ?>
<script>
  if (!window.vytuxCousinsInit) {
    window.vytuxCousinsInit = true;
    document.addEventListener("change", function (event) {
      var box = event.target;
      if (!box.classList || !(box.classList.contains("vytux-cousins-option") || box.classList.contains("vytux-cousins-degree"))) { return; }
      var tab = box.closest(".wt-tab-vytux-cousins");
      var url = new URL(tab.dataset.vytuxCousinsUrl, window.location.href);
      tab.querySelectorAll(".vytux-cousins-option").forEach(function (o) {
        url.searchParams.set("include_" + o.dataset.option, o.checked ? "1" : "0");
      });
      var degree = tab.querySelector(".vytux-cousins-degree");
      if (degree) { url.searchParams.set("max_degree", degree.value); }
      if (window.vytuxCousinsRequest) { window.vytuxCousinsRequest.abort(); }
      var controller = window.vytuxCousinsRequest = new AbortController();
      fetch(url, {signal: controller.signal}).then(function (r) {
        if (!r.ok) { return r.text().then(function (body) { throw new Error(r.status + " " + body.substring(0, 500)); }); }
        return r.text();
      }).then(function (html) {
        tab.outerHTML = html;
      }).catch(function (error) {
        if (error.name === "AbortError") { return; }
        console.error("vytux_cousins: failed to refresh the tab", error);
        if (box.type === "checkbox") {
          box.checked = !box.checked;
        } else {
          box.querySelectorAll("option").forEach(function (o) { o.selected = o.defaultSelected; });
        }
      });
    });
  }
</script><script>
  var newSheet=document.createElement("link");
  newSheet.setAttribute("rel","stylesheet");
  newSheet.setAttribute("type","text/css");
  newSheet.setAttribute("href","<?= $cousins_css ?>");
  document.head.appendChild(newSheet);
</script>
<?php View::endpush() ?>

